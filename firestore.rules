rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify custom admin claim
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Secure admin-only collections
    match /users/{userId} {
      // Admins have full access. Users can read/update their own profile.
      allow read, update: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /site_stats/{statId} {
      allow read, write: if isAdmin();
    }
    
    match /user_activity/{activityId} {
      allow read: if isAdmin();
      allow create: if true; // Allow anonymous tracking logs
    }

    // Lock down everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}